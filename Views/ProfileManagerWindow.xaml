<Window x:Class="WartalesEditor.Views.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Manager"
        Width="1050"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="{Binding Header}"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="DimGray"
                       Text="Browse and manage profiles stored in the Wartales Editor profile library."/>
        </StackPanel>

        <DockPanel Grid.Row="2"
                   LastChildFill="False">

            <Button DockPanel.Dock="Right"
                    Width="100"
                    Padding="10,5"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"/>

            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal">

                <Button Width="100"
                        Padding="10,5"
                        Command="{Binding CreateCommand}"
                        Content="New"/>

                <Button Width="100"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Command="{Binding RenameCommand}"
                        Content="Rename"/>

                <Button Width="100"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Command="{Binding DuplicateCommand}"
                        Content="Duplicate"/>

                <Separator Margin="10,0"
                           Width="1"/>

                <Button Width="110"
                        Padding="12,6"
                        FontWeight="SemiBold"
                        Command="{Binding ApplyCommand}"
                        Content="Apply"/>

                <Button Width="100"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Command="{Binding ImportCommand}"
                        Content="Import"/>

                <Button Width="100"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Command="{Binding ExportCommand}"
                        Content="Export"/>

                <Separator Margin="10,0"
                           Width="1"/>

                <Button Width="100"
                        Padding="10,5"
                        Command="{Binding DeleteCommand}"
                        Content="Delete"/>

            </StackPanel>

        </DockPanel>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"
                                  MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"
                                  MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ProfileGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FFF7F7F7"
                      MouseDoubleClick="OnProfileGridMouseDoubleClick"
                      PreviewKeyDown="OnProfileGridPreviewKeyDown">


                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                                Value="Transparent"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        MinWidth="170"/>
                    <DataGridTextColumn Header="Author"
                                        Binding="{Binding Author}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Version"
                                        Binding="{Binding ProfileVersion}"
                                        Width="85"/>
                    <DataGridTextColumn Header="Changes"
                                        Binding="{Binding PropertyCount,
                                                          StringFormat={}{0:N0}}"
                                        Width="80"/>
                </DataGrid.Columns>

            </DataGrid>

            <Border Grid.Column="2"
                    Padding="18"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    Background="#FFFAFAFA">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedProfileHeader}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Text="Author"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding SelectedProfileAuthor}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Text="Version"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding SelectedProfileVersion}"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Text="Created"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{Binding SelectedProfileCreatedAt}"/>
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Text="Modified"/>
                        <TextBlock Grid.Row="6"
                                   Grid.Column="1"
                                   Text="{Binding SelectedProfileModifiedAt}"/>

                    </Grid>

                    <Separator Grid.Row="4"/>

                    <StackPanel Grid.Row="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Description"/>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="DimGray"
                                   Text="{Binding SelectedProfileDescription}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Grid.Row="8"/>

                    <StackPanel Grid.Row="10">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Profile Change Count"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding SelectedProfileChangeSummary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Grid.Row="12"/>

                    <StackPanel Grid.Row="13">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Additional Information"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="Tags"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SelectedProfileTags}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="File"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedProfileFileName}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                </Grid>

            </Border>

            <Border Grid.ColumnSpan="3"
                    Padding="24"
                    Background="White">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProfiles}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="No mod profiles found"/>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="DimGray"
                               Text="Import a profile or save one to the Wartales Editor profile library."/>

                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="110"
                                Padding="10,5"
                                Command="{Binding ImportCommand}"
                                Content="Import"/>
                        <Button Width="110"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh"/>
                    </StackPanel>
                </StackPanel>

            </Border>

        </Grid>

        <DockPanel Grid.Row="6"
                   LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Width="100"
                    Padding="10,5"
                    Content="Close"
                    Click="OnCloseButtonClick"/>
            <TextBlock VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="{Binding Status}"/>
        </DockPanel>

    </Grid>

</Window>
