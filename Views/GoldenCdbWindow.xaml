<Window x:Class="WartalesEditor.Views.GoldenCdbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        Title="Golden CDB"
        Width="900" Height="620" MinWidth="720" MinHeight="480"
        ResizeMode="CanResize" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="{StaticResource UtilityWindowOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Golden CDB"
                       Style="{StaticResource UtilityMajorHeadingTextStyle}"/>
            <TextBlock Text="{Binding Explanation}" Margin="0,8,0,0"
                       TextWrapping="Wrap" Style="{StaticResource SupportingTextStyle}"/>
        </StackPanel>

        <Border Grid.Row="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource InformationalPanelStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ApplyFeedbackBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ApplyFeedbackBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0"
                           Style="{StaticResource SupportingTextStyle}"/>
                <Grid Margin="0,10,0,0"
                      Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Stored file" FontWeight="SemiBold" Margin="0,0,16,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="0,0,0,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource InformationalPanelStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOperationStatus}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOperationStatusSuccess}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ApplyFeedbackBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ApplyFeedbackBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="OperationStatusText"
                       Text="{Binding OperationStatus}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SupportingTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOperationStatusSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ValidationSuccessTextBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOperationStatusWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ModifiedAccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOperationStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GameplayValidationTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel>
                <Button Content="{Binding SetCurrentText}" MinWidth="190" Margin="0,0,8,8"
                        IsEnabled="{Binding CanSetCurrent}" Click="SetCurrentButton_Click"/>
                <Button Content="{Binding SelectText}" MinWidth="170" Margin="0,0,8,8"
                        IsEnabled="{Binding CanSelect}" Click="SelectButton_Click"/>
                <Button Content="Import Current Wartales CDB as Golden" MinWidth="245" Margin="0,0,8,8"
                        IsEnabled="{Binding CanImport}" Click="ImportCurrentWartalesButton_Click"/>
                <Button Content="Load Golden CDB" MinWidth="145" Margin="0,0,8,8"
                        IsEnabled="{Binding CanLoad}" Click="LoadButton_Click"/>
                <Button Content="Compare Current to Golden" MinWidth="190" Margin="0,0,8,8"
                        IsEnabled="{Binding CanCompare}" Click="CompareButton_Click"/>
                <Button Content="Remove Golden CDB" MinWidth="155" Margin="0,0,0,8"
                        IsEnabled="{Binding CanRemove}" Click="RemoveButton_Click"/>
            </WrapPanel>

            <StackPanel Grid.Row="2"
                        Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ComparisonSummary}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CoverageMessage}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Style="{StaticResource SupportingTextStyle}"
                           Visibility="{Binding HasCoverageWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <DataGrid Grid.Row="4" ItemsSource="{Binding Differences}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="1.4*"/>
                    <DataGridTextColumn Header="Entry" Binding="{Binding Entry}" Width="1.4*"/>
                    <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="1.8*"/>
                    <DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="1.2*"/>
                    <DataGridTextColumn Header="Golden" Binding="{Binding GoldenValue}" Width="1.4*"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="1.4*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Button Grid.Row="8" Content="Close" Width="90" HorizontalAlignment="Right"
                Style="{StaticResource GameplayCloseButtonStyle}" IsCancel="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
