<Window x:Class="WartalesEditor.Views.PathXpRewardsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="680" Height="700"
        MinWidth="620" MinHeight="560" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource GameplayDialogOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Increases the standard Path challenge reward values independently for each Path. Special rewards and other runtime bonuses are unchanged."
                   Style="{StaticResource DialogExplanationTextStyle}"/>
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding DisplayName}" Margin="0,0,0,6">
                            <StackPanel Margin="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption}"
                                              DisplayMemberPath="DisplayText" Width="96"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ApplyFeedback.Message}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Left" Content="Restore Previous Values"
                                            IsEnabled="{Binding CanRestorePreviousValues}"
                                            Click="RestoreButton_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Apply"
                                            Style="{StaticResource GameplayApplyButtonStyle}"
                                            IsEnabled="{Binding CanApply}" Click="ApplyButton_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="{StaticResource DialogActionRowSpacing}" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close"
                    Style="{StaticResource GameplayCloseButtonStyle}"
                    IsCancel="True" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
