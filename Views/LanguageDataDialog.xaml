<Window x:Class="WartalesEditor.Views.LanguageDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        Title="Wartales Language Data"
        Width="500"
        Height="380"
        MinWidth="460"
        MinHeight="340"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="{StaticResource UtilityWindowOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Heading}"
                       Style="{StaticResource UtilityMajorHeadingTextStyle}"/>

            <TextBlock Text="{Binding Explanation}"
                       Margin="0,10,0,16"
                       TextWrapping="Wrap"
                       Style="{StaticResource SupportingTextStyle}"/>

            <Border>
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource InformationalPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource ApplyFeedbackBackgroundBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource ApplyFeedbackBorderBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Visibility="{Binding IsAvailable,
                                               Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Language code"
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding LanguageCode}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Localized names"
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding MappingCount}"/>
                    </Grid>

                    <TextBlock Text="{Binding DiagnosticSummary}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource SupportingTextStyle}"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,0"
                       Text="The selected file is copied into editor-owned storage. Its original location is not needed afterward."
                       TextWrapping="Wrap"
                       Style="{StaticResource SupportingTextStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource DialogActionRowSpacing}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding ActionText}"
                    MinWidth="170"
                    Padding="10,5"
                    Margin="{StaticResource ActionButtonSpacing}"
                    Click="SelectButton_Click"/>
            <Button Content="Close"
                    Style="{StaticResource GameplayCloseButtonStyle}"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
