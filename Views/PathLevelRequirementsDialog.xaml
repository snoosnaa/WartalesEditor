<Window x:Class="WartalesEditor.Views.PathLevelRequirementsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="620" Height="500"
        MinWidth="540" MinHeight="420" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource GameplayDialogOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Lowers the XP required to reach each Path level for all Paths."
                   Style="{StaticResource DialogExplanationTextStyle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Current setting:" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding CurrentStateText}"/>
        </StackPanel>
        <GroupBox Grid.Row="2" Header="Level requirement" Margin="0,16,0,0">
            <StackPanel Margin="12">
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption}"
                          DisplayMemberPath="DisplayText" MinWidth="220"
                          HorizontalAlignment="Left"/>
                <Border Style="{StaticResource InformationalPanelStyle}" Margin="0,14,0,0">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Row="3" Margin="{StaticResource DialogActionRowSpacing}">
            <Border Style="{StaticResource GameplayApplyFeedbackPanelStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding ApplyFeedback.Heading}"
                               Style="{StaticResource GameplayApplyFeedbackHeadingStyle}"/>
                    <TextBlock Text="{Binding ApplyFeedback.Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Restore Previous Values"
                        IsEnabled="{Binding CanRestorePreviousValues}"
                        ToolTip="Restores the Path level requirement values from before this tool was first applied."
                        ToolTipService.ShowOnDisabled="True" Click="RestoreButton_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply" Style="{StaticResource GameplayApplyButtonStyle}"
                            IsEnabled="{Binding CanApply}" Click="ApplyButton_Click"/>
                    <Button Content="Close" Style="{StaticResource GameplayCloseButtonStyle}"
                            IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
