<Window x:Class="WartalesEditor.Views.ProfileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="540"
        Height="560"
        MinWidth="460"
        MinHeight="480"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Profile Name *"
                           FontWeight="SemiBold" />

                <TextBox x:Name="ProfileNameTextBox"
                         Grid.Row="2"
                         Text="{Binding ProfileName,
                                        UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="30"
                         VerticalContentAlignment="Center"
                         MaxLength="120" />

                <TextBlock Grid.Row="4"
                           Text="{Binding ProfileNameValidationMessage}"
                           Foreground="Firebrick"
                           FontSize="12" />

                <TextBlock Grid.Row="6"
                           Text="Author (optional)"
                           FontWeight="SemiBold" />

                <TextBox Grid.Row="8"
                         Text="{Binding Author,
                                        UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="30"
                         VerticalContentAlignment="Center"
                         MaxLength="120" />

                <TextBlock Grid.Row="10"
                           Text="Profile Version"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Row="12">
                    <TextBox Text="{Binding ProfileVersion,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             MaxLength="40" />

                    <TextBlock Text="{Binding ProfileVersionValidationMessage}"
                               Foreground="Firebrick"
                               FontSize="12"
                               Margin="0,8,0,0" />

                    <TextBlock Text="Identifies this profile's release, not the Wartales version."
                               Style="{StaticResource SupportingTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="14"
                           Text="Description (optional)"
                           FontWeight="SemiBold" />

                <TextBox Grid.Row="16"
                         Text="{Binding Description,
                                        UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="140"
                         MaxLength="2000" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    MinHeight="32"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click" />

            <Button Content="{Binding ConfirmationButtonText}"
                    Width="110"
                    MinHeight="32"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
