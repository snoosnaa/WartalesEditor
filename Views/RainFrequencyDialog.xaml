<Window x:Class="WartalesEditor.Views.RainFrequencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="600" Height="410"
        MinWidth="520" MinHeight="360" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource GameplayDialogOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Control how often ordinary rain occurs across supported regions. Other weather systems remain unchanged."
                   Style="{StaticResource DialogExplanationTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Current preset:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentStateText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Preset" Margin="0,16,0,0">
            <StackPanel Margin="12">
                <ComboBox ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" MinWidth="220"
                          HorizontalAlignment="Left"/>
                <Border Style="{StaticResource InformationalPanelStyle}"
                        Margin="0,14,0,0">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="3"
                   Grid.RowSpan="2"
                   LastChildFill="False"
                   Margin="{StaticResource DialogActionRowSpacing}">
            <Button DockPanel.Dock="Left"
                    Content="Reset to Vanilla"
                    Click="ResetButton_Click"/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Content="Apply"
                        Style="{StaticResource GameplayApplyButtonStyle}"
                        IsEnabled="{Binding CanApply}"
                        Click="ApplyButton_Click"/>
                <Button Content="Close"
                        Style="{StaticResource GameplayCloseButtonStyle}"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
