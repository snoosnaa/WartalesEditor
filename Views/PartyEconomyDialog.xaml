<Window x:Class="WartalesEditor.Views.PartyEconomyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        Title="{Binding Title}" Width="620" Height="430"
        MinWidth="540" MinHeight="380" SizeToContent="Manual"
        WindowState="Normal" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <GroupBox Header="Volunteer Wage Reduction"
                      Visibility="{Binding IsVolunteer, Converter={StaticResource BoolVis}}">
                <Grid Margin="12" ToolTip="Adjusts the wage reduction granted by the Volunteer trait. 100% means companions with the Volunteer trait require no Krowns during wage payments.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Volunteer Wage Reduction" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="80" Text="{Binding VolunteerPercentage, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Validation.Error="InputValidationError"/>
                        <TextBlock Text="%" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Valour settings"
                      Visibility="{Binding IsValour, Converter={StaticResource BoolVis}}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Maximum Valour" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="4" Text="{Binding MaximumValour, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Validation.Error="InputValidationError"/>
                    <TextBlock Grid.Row="1" Text="Valour Restored After Rest" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding RestoredValour, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Validation.Error="InputValidationError"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Carrying capacity"
                      Visibility="{Binding IsCarrying, Converter={StaticResource BoolVis}}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Saddlebag Capacity Bonus" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="4" Text="{Binding SaddlebagCapacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Validation.Error="InputValidationError"/>
                    <TextBlock Grid.Row="1" Text="Pony Starting Capacity" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding PonyStartingCapacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Validation.Error="InputValidationError"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Preview" Margin="0,14,0,0">
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="12"/>
            </GroupBox>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="DarkRed"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                    Margin="0,14,0,0">
            <Button Content="Reset to Game Default"
                    Margin="0,0,8,0" Click="ResetButton_Click"/>
            <Button Content="No Wages"
                    Visibility="{Binding IsVolunteer, Converter={StaticResource BoolVis}}"
                    Click="NoWagesButton_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Apply" Width="100" Margin="0,0,8,0"
                    IsEnabled="{Binding CanApply}" Click="ApplyButton_Click"/>
            <Button Content="Close" Width="90" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
