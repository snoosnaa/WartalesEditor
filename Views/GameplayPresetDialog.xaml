<Window x:Class="WartalesEditor.Views.GameplayPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="660" Height="600"
        MinWidth="560" MinHeight="500"
        SizeToContent="Manual"
        WindowState="Normal"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource GameplayDialogOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Description}"
                   Style="{StaticResource DialogExplanationTextStyle}"/>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Current setting:" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                       Text="{Binding CurrentStateText}"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Preset" Margin="0,14,0,0">
            <ComboBox Margin="12"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="DisplayText"/>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Preview" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding PreviewText}"
                           Margin="12"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="{StaticResource DialogActionRowSpacing}">
            <Border Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource InformationalPanelStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Definition.HasInformationalNote}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Definition.InformationalNote}"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource GameplayApplyFeedbackPanelStyle}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding ApplyFeedback.Heading}"
                               Style="{StaticResource GameplayApplyFeedbackHeadingStyle}"/>
                    <TextBlock Text="{Binding ApplyFeedback.Message}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Reset to Game Default"
                        Click="ResetButton_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply"
                            Style="{StaticResource GameplayApplyButtonStyle}"
                            IsEnabled="{Binding CanApply}"
                            Click="ApplyButton_Click"/>
                    <Button Content="Close"
                            Style="{StaticResource GameplayCloseButtonStyle}"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
