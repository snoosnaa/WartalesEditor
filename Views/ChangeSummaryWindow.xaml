<Window x:Class="WartalesEditor.Views.ChangeSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Summary"
        Width="1100"
        Height="650"
        MinWidth="800"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="{StaticResource UtilityWindowOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Header}"
                       Style="{StaticResource UtilityMajorHeadingTextStyle}"/>

            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SupportingTextStyle}"
                       Text="Review all properties that currently differ from the saved baseline."/>
        </StackPanel>

        <!-- Change list -->
        <Grid Grid.Row="2">

            <DataGrid x:Name="ChangeSummaryDataGrid"
                      ItemsSource="{Binding GroupedItems}"
                      SelectedItem="{Binding SelectedItem,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="{StaticResource UtilityAlternatingRowBackgroundBrush}">

                <!-- Category and Setting groups -->
                <DataGrid.GroupStyle>

                    <!-- Category level -->
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">

                                <Setter Property="Margin"
                        Value="0,4,0,4"/>

                                <Setter Property="Template">
                                    <Setter.Value>

                                        <ControlTemplate TargetType="GroupItem">

                                            <Expander IsExpanded="True">

                                                <Expander.Header>

                                                    <Border Padding="8,6"
                                            Background="#FFE8E8E8"
                                            BorderBrush="#FFD0D0D0"
                                            BorderThickness="0,0,0,1">

                                                        <DockPanel LastChildFill="True">

                                                            <TextBlock DockPanel.Dock="Left"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name,
                                                                      Mode=OneWay}"/>

                                                            <TextBlock Margin="8,0,0,0"
                                                       Foreground="{StaticResource SupportingTextBrush}">

                                                <Run Text="("/>

                                                <Run Text="{Binding ItemCount,
                                                                    Mode=OneWay}"/>

                                                <Run Text=" changes)"/>

                                                            </TextBlock>

                                                        </DockPanel>

                                                    </Border>

                                                </Expander.Header>

                                                <ItemsPresenter/>

                                            </Expander>

                                        </ControlTemplate>

                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>

                    <!-- Setting level -->
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">

                                <Setter Property="Margin"
                        Value="18,2,0,2"/>

                                <Setter Property="Template">
                                    <Setter.Value>

                                        <ControlTemplate TargetType="GroupItem">

                                            <Expander IsExpanded="False">

                                                <Expander.Header>

                                                    <Border Padding="8,5"
                                            Background="#FFF5F5F5"
                                            BorderBrush="#FFDDDDDD"
                                            BorderThickness="0,0,0,1">

                                                        <DockPanel LastChildFill="True">

                                                            <TextBlock DockPanel.Dock="Left"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name,
                                                                      Mode=OneWay}"/>

                                                            <TextBlock Margin="8,0,0,0"
                                                       Foreground="{StaticResource SupportingTextBrush}">

                                                <Run Text="("/>

                                                <Run Text="{Binding ItemCount,
                                                                    Mode=OneWay}"/>

                                                <Run Text=" properties)"/>

                                                            </TextBlock>

                                                        </DockPanel>

                                                    </Border>

                                                </Expander.Header>

                                                <ItemsPresenter/>

                                            </Expander>

                                        </ControlTemplate>

                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>

                </DataGrid.GroupStyle>

                <DataGrid.Columns>

                    
                    
                    <DataGridTextColumn Header="Property"
                                        Binding="{Binding PropertyName,
                                                          Mode=OneWay}"
                                        Width="190"/>

                    <DataGridTemplateColumn Header="Original Value"
                                            Width="*"
                                            MinWidth="180">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Margin="6,4"
                                           Text="{Binding OriginalValue,
                                                          Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Current Value"
                                            Width="*"
                                            MinWidth="180">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Margin="6,4"
                                           Text="{Binding CurrentValue,
                                                          Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <!-- Empty state -->
            <Border>

                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource EmptyStateContainerStyle}">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}"
                                         Value="False">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource EmptyStateHeadingTextStyle}"
                               Text="No modified properties"/>

                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource EmptyStateSupportingTextStyle}"
                               Text="The current project matches its saved baseline."/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Actions -->
        <DockPanel Grid.Row="4"
                   LastChildFill="False">

            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SupportingTextBrush}"
                       Text="Select a change and choose Navigate to locate it in the editor."/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">

                <Button Style="{StaticResource UtilityActionButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}"
                        Content="Navigate"
                        IsDefault="True"/>

                <Button Style="{StaticResource UtilityActionButtonStyle}"
                        Content="Close"
                        Click="OnCloseButtonClick"/>

            </StackPanel>

        </DockPanel>

    </Grid>
</Window>
