<Window x:Class="WartalesEditor.Views.RequestBoardRewardsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="620" Height="520"
        MinWidth="540" MinHeight="440" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource GameplayDialogOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Increase the base Krown rewards offered by Tavern Request Board missions. Mission-specific bonuses and other gameplay modifiers still affect the final payout."
                   Style="{StaticResource DialogExplanationTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Current preset:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentStateText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Base reward preset" Margin="0,16,0,0">
            <StackPanel Margin="12">
                <ComboBox ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" MinWidth="220"
                          HorizontalAlignment="Left"/>
                <Border Style="{StaticResource InformationalPanelStyle}"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Higher negotiated rewards may also require more Influence."
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Grid.RowSpan="2"
                    Margin="{StaticResource DialogActionRowSpacing}">
            <Border Style="{StaticResource GameplayApplyFeedbackPanelStyle}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding ApplyFeedback.Heading}"
                               Style="{StaticResource GameplayApplyFeedbackHeadingStyle}"/>
                    <TextBlock Text="{Binding ApplyFeedback.Message}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Restore Previous Values"
                        IsEnabled="{Binding CanRestorePreviousValues}"
                        ToolTip="Restores the base reward ranges from before this gameplay tool was first applied."
                        ToolTipService.ShowOnDisabled="True"
                        Click="RestoreButton_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply"
                            Style="{StaticResource GameplayApplyButtonStyle}"
                            IsEnabled="{Binding CanApply}"
                            Click="ApplyButton_Click"/>
                    <Button Content="Close"
                            Style="{StaticResource GameplayCloseButtonStyle}"
                            IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
