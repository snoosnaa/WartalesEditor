<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SupportingTextBrush" Color="DimGray"/>
    <SolidColorBrush x:Key="ModifiedAccentBrush" Color="DarkOrange"/>
    <SolidColorBrush x:Key="ModifiedRowBackgroundBrush" Color="LightGoldenrodYellow"/>
    <SolidColorBrush x:Key="ReadOnlyEditorBackgroundBrush" Color="Gainsboro"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="UtilityAlternatingRowBackgroundBrush" Color="#FFF7F7F7"/>
    <SolidColorBrush x:Key="GameplayValidationTextBrush" Color="DarkRed"/>
    <SolidColorBrush x:Key="ValidationSuccessTextBrush" Color="DarkGreen"/>
    <SolidColorBrush x:Key="ApplyFeedbackBackgroundBrush" Color="#EEF8EE"/>
    <SolidColorBrush x:Key="ApplyFeedbackBorderBrush" Color="#79A879"/>
    <SolidColorBrush x:Key="InformationalPanelBackgroundBrush" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="InformationalPanelBorderBrush" Color="#E0B35B"/>
    <SolidColorBrush x:Key="EmptyStateBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="WorkspacePanelBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="WorkspacePanelBorderBrush" Color="#FFC4C4C4"/>

    <Thickness x:Key="GameplayDialogOuterMargin">20</Thickness>
    <Thickness x:Key="UtilityWindowOuterMargin">16</Thickness>
    <Thickness x:Key="ActionButtonSpacing">0,0,8,0</Thickness>
    <Thickness x:Key="CommonPanelPadding">12</Thickness>
    <Thickness x:Key="MainWorkspaceMargin">20</Thickness>
    <Thickness x:Key="WorkspaceSelectorSpacing">0,0,18,0</Thickness>
    <Thickness x:Key="DashboardColumnSpacing">0,0,16,0</Thickness>
    <Thickness x:Key="GameplayCategorySpacing">0,0,0,12</Thickness>
    <Thickness x:Key="GameplayCategoryPanelPadding">16</Thickness>
    <Thickness x:Key="DialogSectionSpacing">0,0,0,14</Thickness>
    <Thickness x:Key="DialogActionRowSpacing">0,14,0,0</Thickness>

    <Style x:Key="UtilityMajorHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SupportingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SupportingTextBrush}"/>
    </Style>

    <Style x:Key="DialogExplanationTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SupportingTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{StaticResource DialogSectionSpacing}"/>
    </Style>

    <Style x:Key="EmptyStateHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="EmptyStateSupportingTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SupportingTextStyle}"/>

    <Style x:Key="GameplayValidationTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GameplayValidationTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="InformationalPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InformationalPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InformationalPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CommonPanelPadding}"/>
    </Style>

    <Style x:Key="GameplayApplyFeedbackPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ApplyFeedbackBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ApplyFeedbackBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ApplyFeedback.IsVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameplayApplyFeedbackHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ValidationSuccessTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="EmptyStateContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EmptyStateBackgroundBrush}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="GameplayApplyButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="{StaticResource ActionButtonSpacing}"/>
    </Style>

    <Style x:Key="GameplayCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="90"/>
    </Style>

    <Style x:Key="UtilityActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="UtilityWideActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="110"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="WorkspaceSelectorStyle" TargetType="RadioButton">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="{StaticResource WorkspaceSelectorSpacing}"/>
        <Setter Property="Padding" Value="4,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameplayCategoryPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WorkspacePanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WorkspacePanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="{StaticResource GameplayCategoryPanelPadding}"/>
        <Setter Property="Margin" Value="{StaticResource GameplayCategorySpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="GameplayCategoryHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="GameplayToolButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>

    <Style x:Key="DetailedEditorContextPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WorkspacePanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WorkspacePanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style x:Key="DetailedEditorContextHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DetailedEditorSectionHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DetailedEditorEmptyStateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource EmptyStateSupportingTextStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DetailedEditorLocalActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="MinWidth" Value="135"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>

    <Style x:Key="SearchClearButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="ToolTip" Value="Clear search"/>
    </Style>
</ResourceDictionary>
