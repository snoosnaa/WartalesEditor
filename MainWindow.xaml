<Window x:Class="WartalesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:WartalesEditor.Selectors"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        xmlns:validation="clr-namespace:WartalesEditor.Validation"
        xmlns:services="clr-namespace:WartalesEditor.Services"
        xmlns:models="clr-namespace:WartalesEditor.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="550"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <converters:BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <converters:FirstValidationErrorConverter
            x:Key="FirstValidationErrorConverter"/>

        <!-- Standard text property -->
        <DataTemplate x:Key="TextEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}"
                     Text="{Binding Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

        </DataTemplate>

        <!-- Integer or decimal property -->
        <DataTemplate x:Key="NumberEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}">

                <TextBox.Style>

                    <Style TargetType="TextBox">

                        <Setter Property="ToolTip"
                                Value="{x:Null}"/>

                        <Style.Triggers>

                            <Trigger Property="Validation.HasError"
                                     Value="True">

                                <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                        Path=(Validation.Errors),
                                                        Converter={StaticResource FirstValidationErrorConverter}}"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </TextBox.Style>

                <TextBox.Text>

                    <Binding Path="Value"
                             Mode="TwoWay"
                             UpdateSourceTrigger="PropertyChanged"
                             ValidatesOnExceptions="True"
                             NotifyOnValidationError="True">

                        <Binding.ValidationRules>

                            <validation:PropertyValidationRule
                                ValidationStep="UpdatedValue"/>

                        </Binding.ValidationRules>

                    </Binding>

                </TextBox.Text>

            </TextBox>

        </DataTemplate>

        <!-- Boolean property -->
        <DataTemplate x:Key="BooleanEditorTemplate">

            <CheckBox IsChecked="{Binding Value,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"
                      VerticalAlignment="Center"
                      Margin="5,0"/>

        </DataTemplate>

        <!-- Property with a known list of valid choices -->
        <DataTemplate x:Key="DropdownEditorTemplate">

            <ComboBox Width="330"
                      ItemsSource="{Binding AvailableValues}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Value,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"/>

        </DataTemplate>

        <!-- Array or object awaiting a dedicated editor -->
        <DataTemplate x:Key="ComplexEditorTemplate">

            <TextBox Width="330"
                     MinHeight="55"
                     MaxHeight="180"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource ReadOnlyEditorBackgroundBrush}"
                     Text="{Binding Value}"/>

        </DataTemplate>

        <!-- Internal or otherwise protected property -->
        <DataTemplate x:Key="ReadOnlyEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="True"
                     Background="{StaticResource ReadOnlyEditorBackgroundBrush}"
                     Text="{Binding Value}"/>

        </DataTemplate>

        <selectors:PropertyEditorTemplateSelector
            x:Key="PropertyEditorSelector"
            TextTemplate="{StaticResource TextEditorTemplate}"
            NumberTemplate="{StaticResource NumberEditorTemplate}"
            BooleanTemplate="{StaticResource BooleanEditorTemplate}"
            DropdownTemplate="{StaticResource DropdownEditorTemplate}"
            ComplexTemplate="{StaticResource ComplexEditorTemplate}"
            ReadOnlyTemplate="{StaticResource ReadOnlyEditorTemplate}"/>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Application Menu -->
        <Menu Grid.Row="0">

            <MenuItem Header="_File">

                <MenuItem Header="_Open..."
                          Command="{Binding OpenCommand}"
                          InputGestureText="Ctrl+O"/>

                <MenuItem Header="_Save As..."
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S"/>

                <Separator/>

                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click"/>

            </MenuItem>

            <MenuItem Header="_Edit">

                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="{Binding UndoDescription}"/>

                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGestureText="Ctrl+Y"
                          ToolTip="{Binding RedoDescription}"/>

                <Separator/>

                <MenuItem Header="_Reset Selected Property"
                          Command="{Binding ResetSelectedPropertyCommand}"/>

            </MenuItem>

            <MenuItem Header="_View">

                <MenuItem Header="_Gameplay Tools"
                          IsCheckable="True"
                          IsChecked="{Binding IsGameplayToolsWorkspace, Mode=OneWay}"
                          Command="{Binding ShowGameplayToolsWorkspaceCommand}"/>

                <MenuItem Header="_Detailed Editor"
                          IsCheckable="True"
                          IsChecked="{Binding IsDetailedEditorWorkspace, Mode=OneWay}"
                          Command="{Binding ShowDetailedEditorWorkspaceCommand}"/>

                <Separator/>

                <MenuItem Header="_Change Summary"
                          Command="{Binding ShowChangeSummaryCommand}"/>

            </MenuItem>

            <MenuItem Header="_Tools">

                <MenuItem Header="_Profile Manager"
                          Command="{Binding ShowProfileManagerCommand}"
                          ToolTip="Browse mod profiles stored in the Wartales Editor profile library."/>

                <Separator/>

                <MenuItem Header="_Snapshots">

                    <MenuItem Header="_Export Snapshot..."
                              Command="{Binding ExportSnapshotCommand}"
                              ToolTip="Export the current project modifications to a snapshot file."/>

                    <MenuItem Header="_Preview Snapshot..."
                              Command="{Binding PreviewSnapshotCommand}"
                              ToolTip="Preview how a snapshot would apply without modifying the project."/>

                    <MenuItem Header="_Import Snapshot..."
                              Command="{Binding ImportSnapshotCommand}"
                              ToolTip="Safely import and apply compatible changes from a snapshot file."/>

                </MenuItem>

                <Separator/>

                <MenuItem Header="_Validate Project"
                          Command="{Binding ValidateProjectCommand}"
                          ToolTip="Run the validation framework against the current project."/>

            </MenuItem>

            <MenuItem Header="_Help">

                <MenuItem Header="_About Wartales Editor"
                          IsEnabled="False"/>

            </MenuItem>

        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">

            <Button Name="OpenButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding OpenCommand}">
                Open
            </Button>

            <Button Name="SaveButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding SaveCommand}">
                Save
            </Button>

            <Separator/>

            <Button Name="UndoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding UndoCommand}"
                    ToolTip="{Binding UndoDescription}">
                Undo
            </Button>

            <Button Name="RedoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding RedoCommand}"
                    ToolTip="{Binding RedoDescription}">
                Redo
            </Button>

            <Separator/>

            <Button Name="ResetPropertyButton"
                    Width="120"
                    Margin="5"
                    Command="{Binding ResetSelectedPropertyCommand}">
                Reset Property
            </Button>

            <Separator/>

            <Button Name="ChangeSummaryButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowChangeSummaryCommand}">
                Change Summary
            </Button>

            <Button Name="ValidateProjectButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ValidateProjectCommand}">
                Validate Project
            </Button>

            <Button Name="ProfileManagerButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowProfileManagerCommand}">
                Profile Manager
            </Button>

        </ToolBar>

        <!-- Workspace selectors -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="20,6,20,6">

            <RadioButton Content="Gameplay Tools"
                         GroupName="MainWorkspace"
                         Style="{StaticResource WorkspaceSelectorStyle}"
                         IsChecked="{Binding IsGameplayToolsWorkspace, Mode=OneWay}"
                         Command="{Binding ShowGameplayToolsWorkspaceCommand}"/>

            <RadioButton Content="Detailed Editor"
                         GroupName="MainWorkspace"
                         Style="{StaticResource WorkspaceSelectorStyle}"
                         IsChecked="{Binding IsDetailedEditorWorkspace, Mode=OneWay}"
                         Command="{Binding ShowDetailedEditorWorkspaceCommand}"/>

        </StackPanel>

        <!-- No-project welcome state -->
        <Grid Grid.Row="3"
              Grid.RowSpan="3"
              Margin="{StaticResource MainWorkspaceMargin}"
              Visibility="{Binding ShowWelcomeState,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560">

                <TextBlock Text="Open a Wartales data.cdb file to begin"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Style="{StaticResource UtilityMajorHeadingTextStyle}"/>

                <TextBlock Margin="0,10,0,0"
                           Text="Open your extracted data.cdb file to access Gameplay Tools and the Detailed Editor. Your changes are tracked automatically and can be reviewed before saving."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource SupportingTextStyle}"/>

                <StackPanel Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Content="Open"
                            Style="{StaticResource UtilityActionButtonStyle}"
                            Command="{Binding OpenCommand}"/>
                    <Button Content="Profile Manager"
                            Width="130"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding ShowProfileManagerCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Gameplay Tools workspace -->
        <ScrollViewer Grid.Row="3"
                      Grid.RowSpan="3"
                      Margin="{StaticResource MainWorkspaceMargin}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsGameplayToolsAvailable,
                                           Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="{StaticResource DashboardColumnSpacing}">
                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Starting Game"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Starting Resources"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding StartingResourcesCommand}"
                                    ToolTip="Add extra supplies to every standard new campaign start."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Progression"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="XP Progression"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayProgressionCommand}"
                                    ToolTip="Configure character and profession XP requirements."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Camp &amp; Equipment"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Add Camp Facilities"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding ContentCreationCommand}"
                                    CommandParameter="{x:Static services:ContentCreationOperation.AddCampFacilities}"
                                    ToolTip="Enable the Anvil and Apothecary Table and add their Workshop recipes."/>
                            <Button Content="Upgrade All Equipment"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding ContentCreationCommand}"
                                    CommandParameter="{x:Static services:ContentCreationOperation.UpgradeAllEquipment}"
                                    ToolTip="Allow obtainable equipment to be upgraded at the Brotherhood Training Grounds."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Party"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Volunteer Trait"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.VolunteerWages}"
                                    ToolTip="Configure the wage reduction granted by the Volunteer trait."/>
                            <Button Content="Valour Points"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.ValourPoints}"
                                    ToolTip="Configure base maximum Valour and Valour restored after rest."/>
                            <Button Content="Carrying Capacity"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.CarryingCapacity}"
                                    ToolTip="Configure saddlebags and pony starting carrying capacity."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="World"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Movement Speed"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding OverworldMovementSpeedCommand}"
                                    ToolTip="Choose how quickly your party travels across the world map."/>
                            <Button Content="Rain Frequency"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding RainFrequencyCommand}"
                                    ToolTip="Choose how often ordinary rain occurs across supported regions."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Detailed Editor workspace -->
        <Grid Grid.Row="3"
              Grid.RowSpan="3"
              Visibility="{Binding IsDetailedEditorAvailable,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Search -->
        <DockPanel Grid.Row="0"
                   Margin="5">

            <TextBlock Text="Search:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox Name="SearchBox"
                     Width="250"
                     Margin="0,0,10,0"
                     Text="{Binding SearchText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="In:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox Width="110"
                      Margin="0,0,15,0"
                      SelectedValuePath="Content"
                      SelectedValue="{Binding SearchScope,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}">

                <ComboBoxItem>Settings</ComboBoxItem>
                <ComboBoxItem>Categories</ComboBoxItem>
                <ComboBoxItem>Properties</ComboBoxItem>
                <ComboBoxItem>Item Names</ComboBoxItem>

            </ComboBox>

            <CheckBox Content="Show Empty Categories"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowEmptyCategories,
                                          Mode=TwoWay}"/>

            <TextBlock Text="{Binding LocalizationStatus}"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

        </DockPanel>

        <!-- Find Anything -->
        <Grid Grid.Row="1"
              Margin="5,0,5,5"
              MaxHeight="160"
              Visibility="{Binding HasSearchText,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding FindAnythingHeader}"
                       FontWeight="Bold"
                       Margin="5,3,5,5"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedSearchResult,
                                             Mode=TwoWay}">

                <ListView.View>

                    <GridView>

                        <GridViewColumn Header="Category"
                                        Width="180"
                                        DisplayMemberBinding="{Binding CategoryName}"/>

                        <GridViewColumn Header="Name"
                                        Width="600"
                                        DisplayMemberBinding="{Binding DisplayName}"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Grid>

        <!-- Main Area -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Categories and Settings -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Categories"
                               FontWeight="Bold"
                               Margin="5"/>

                    <TextBlock Grid.Column="1"
                               Text="Settings"
                               FontWeight="Bold"
                               Margin="5"/>

                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>

                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="5"
                             ItemsSource="{Binding Sheets}"
                             SelectedItem="{Binding SelectedSheet}"
                             DisplayMemberPath="Name"/>

                    <ListBox Grid.Column="1"
                             Margin="5"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             DisplayMemberPath="DisplayName"/>

                </Grid>

            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="10,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Properties"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ModificationStatus}"
                               Margin="10,0,5,0"
                               VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="FontWeight"
                                        Value="Normal"/>

                                <Setter Property="Foreground"
                                        Value="Gray"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasModifications}"
                                                 Value="True">

                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>

                                        <Setter Property="Foreground"
                                                Value="{StaticResource ModifiedAccentBrush}"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <ListView x:Name="PropertiesListView"
                          Grid.Row="1"
                          Margin="5"
                          ItemsSource="{Binding Properties}"
                          SelectedItem="{Binding SelectedProperty,
                                                 Mode=TwoWay}"
                          SelectionChanged="PropertiesListView_SelectionChanged">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsModified}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="{StaticResource ModifiedRowBackgroundBrush}"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header=""
                                            Width="28">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="●"
                                                   Foreground="{StaticResource ModifiedAccentBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="This property has unsaved changes"
                                                   Visibility="{Binding IsModified,
                                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Property"
                                            Width="200">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Value"
                                            Width="350">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource PropertyEditorSelector}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Grid>

        </Grid>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="6">

            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=StatusBar},
                                  Path=ActualWidth}">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Name="StatusText"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="●"
                               Foreground="{StaticResource ModifiedAccentBrush}"
                               Margin="0,0,5,0"
                               Visibility="{Binding HasModifications,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding ModificationStatus}">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Foreground"
                                        Value="Gray"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasModifications}"
                                                 Value="True">

                                        <Setter Property="Foreground"
                                                Value="{StaticResource ModifiedAccentBrush}"/>

                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Grid>

        </StatusBar>

    </Grid>

</Window>
