<Window x:Class="WartalesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:WartalesEditor.Selectors"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        xmlns:validation="clr-namespace:WartalesEditor.Validation"
        xmlns:services="clr-namespace:WartalesEditor.Services"
        xmlns:models="clr-namespace:WartalesEditor.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="450"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <converters:BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <converters:FirstValidationErrorConverter
            x:Key="FirstValidationErrorConverter"/>

        <!-- Standard text property -->
        <DataTemplate x:Key="TextEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}"
                     Text="{Binding Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

        </DataTemplate>

        <!-- Integer or decimal property -->
        <DataTemplate x:Key="NumberEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}">

                <TextBox.Style>

                    <Style TargetType="TextBox">

                        <Setter Property="ToolTip"
                                Value="{x:Null}"/>

                        <Style.Triggers>

                            <Trigger Property="Validation.HasError"
                                     Value="True">

                                <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                        Path=(Validation.Errors),
                                                        Converter={StaticResource FirstValidationErrorConverter}}"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </TextBox.Style>

                <TextBox.Text>

                    <Binding Path="Value"
                             Mode="TwoWay"
                             UpdateSourceTrigger="PropertyChanged"
                             ValidatesOnExceptions="True"
                             NotifyOnValidationError="True">

                        <Binding.ValidationRules>

                            <validation:PropertyValidationRule
                                ValidationStep="UpdatedValue"/>

                        </Binding.ValidationRules>

                    </Binding>

                </TextBox.Text>

            </TextBox>

        </DataTemplate>

        <!-- Boolean property -->
        <DataTemplate x:Key="BooleanEditorTemplate">

            <CheckBox IsChecked="{Binding Value,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"
                      VerticalAlignment="Center"
                      Margin="5,0"/>

        </DataTemplate>

        <!-- Property with a known list of valid choices -->
        <DataTemplate x:Key="DropdownEditorTemplate">

            <ComboBox Width="330"
                      ItemsSource="{Binding AvailableValues}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Value,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"/>

        </DataTemplate>

        <!-- Array or object awaiting a dedicated editor -->
        <DataTemplate x:Key="ComplexEditorTemplate">

            <TextBox Width="330"
                     MinHeight="55"
                     MaxHeight="180"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource ReadOnlyEditorBackgroundBrush}"
                     ToolTip="This value is read-only in the Detailed Editor."
                     Text="{Binding Value}"/>

        </DataTemplate>

        <!-- Internal or otherwise protected property -->
        <DataTemplate x:Key="ReadOnlyEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="True"
                     Background="{StaticResource ReadOnlyEditorBackgroundBrush}"
                     ToolTip="This value is protected and cannot be edited."
                     Text="{Binding Value}"/>

        </DataTemplate>

        <selectors:PropertyEditorTemplateSelector
            x:Key="PropertyEditorSelector"
            TextTemplate="{StaticResource TextEditorTemplate}"
            NumberTemplate="{StaticResource NumberEditorTemplate}"
            BooleanTemplate="{StaticResource BooleanEditorTemplate}"
            DropdownTemplate="{StaticResource DropdownEditorTemplate}"
            ComplexTemplate="{StaticResource ComplexEditorTemplate}"
            ReadOnlyTemplate="{StaticResource ReadOnlyEditorTemplate}"/>

    </Window.Resources>

    <Grid IsEnabled="{Binding IsEditorInteractionEnabled}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Application Menu -->
        <Menu Grid.Row="0">

            <MenuItem Header="_File">

                <MenuItem Header="_Import From Wartales..."
                          Command="{Binding ImportFromWartalesCommand}"/>

                <MenuItem Header="_Export Back to Wartales..."
                          Command="{Binding ExportBackToWartalesCommand}"/>

                <Separator/>

                <MenuItem Header="_Open Wartales File..."
                          Command="{Binding OpenCommand}"
                          InputGestureText="Ctrl+O"/>

                <MenuItem Header="_Save Modded File..."
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S"/>

                <Separator/>

                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click"/>

            </MenuItem>

            <MenuItem Header="_Edit">

                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="{Binding UndoDescription}"/>

                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGestureText="Ctrl+Y"
                          ToolTip="{Binding RedoDescription}"/>

                <Separator/>

                <MenuItem Header="_Restore Original Value"
                          Command="{Binding ResetSelectedPropertyCommand}"/>

            </MenuItem>

            <MenuItem Header="_View">

                <MenuItem Header="_Gameplay Tools"
                          IsCheckable="True"
                          IsChecked="{Binding IsGameplayToolsWorkspace, Mode=OneWay}"
                          Command="{Binding ShowGameplayToolsWorkspaceCommand}"/>

                <MenuItem Header="_Detailed Editor"
                          IsCheckable="True"
                          IsChecked="{Binding IsDetailedEditorWorkspace, Mode=OneWay}"
                          Command="{Binding ShowDetailedEditorWorkspaceCommand}"/>

                <Separator/>

                <MenuItem Header="_Review Changes"
                          Command="{Binding ShowChangeSummaryCommand}"/>

            </MenuItem>

            <MenuItem Header="_Tools">

                <MenuItem Header="_Profiles"
                          Command="{Binding ShowProfileManagerCommand}"
                          ToolTip="Create, apply, import, and export profiles."/>

                <MenuItem Header="_Language Data..."
                          Command="{Binding ShowLanguageDataCommand}"
                          ToolTip="Set up or replace localized Wartales names."/>

                <MenuItem Header="_Golden CDB..."
                          Command="{Binding ShowGoldenCdbCommand}"
                          ToolTip="Manage and compare against your reference CDB."/>

                <Separator/>

                <MenuItem Header="_Check Project"
                          Command="{Binding ValidateProjectCommand}"
                          ToolTip="Check whether the current project is ready to save."/>

                <MenuItem Header="_Check Compatibility"
                          Command="{Binding CheckCompatibilityCommand}"
                          ToolTip="Check gameplay features against the currently loaded game data."/>

            </MenuItem>

            <MenuItem Header="_Help">

                <MenuItem Header="_About Wartales Editor"
                          Command="{Binding ShowAboutCommand}"/>

            </MenuItem>

        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">

            <Button Name="OpenButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding OpenCommand}">
                Open
            </Button>

            <Button Name="SaveButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding SaveCommand}">
                Save
            </Button>

            <Separator/>

            <Button Name="UndoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding UndoCommand}"
                    ToolTip="{Binding UndoDescription}">
                Undo
            </Button>

            <Button Name="RedoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding RedoCommand}"
                    ToolTip="{Binding RedoDescription}">
                Redo
            </Button>

            <Separator/>

            <Button Name="ResetPropertyButton"
                    Width="120"
                    Margin="5"
                    Command="{Binding ResetSelectedPropertyCommand}"
                    ToolTip="Restore the selected value to its original value.">
                Restore Value
            </Button>

            <Separator/>

            <Button Name="ChangeSummaryButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowChangeSummaryCommand}">
                Review Changes
            </Button>

            <Button Name="ValidateProjectButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ValidateProjectCommand}">
                Check Project
            </Button>

            <Button Name="ProfileManagerButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowProfileManagerCommand}">
                Profiles
            </Button>

        </ToolBar>

        <!-- Workspace selectors -->
        <Grid Grid.Row="2"
              Margin="20,6,20,6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">

                <RadioButton Content="Gameplay Tools"
                             GroupName="MainWorkspace"
                             Style="{StaticResource WorkspaceSelectorStyle}"
                             IsChecked="{Binding IsGameplayToolsWorkspace, Mode=OneWay}"
                             Command="{Binding ShowGameplayToolsWorkspaceCommand}"/>

                <RadioButton Content="Detailed Editor"
                             GroupName="MainWorkspace"
                             Style="{StaticResource WorkspaceSelectorStyle}"
                             IsChecked="{Binding IsDetailedEditorWorkspace, Mode=OneWay}"
                             Command="{Binding ShowDetailedEditorWorkspaceCommand}"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Name="QuickHelpButton"
                    Content="Quick Help"
                    Style="{StaticResource UtilityActionButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Open quick instructions for common workflows."
                    Command="{Binding ShowQuickHelpCommand}"/>

        </Grid>

        <!-- No-project welcome state -->
        <Grid Grid.Row="3"
              Grid.RowSpan="3"
              Margin="{StaticResource MainWorkspaceMargin}"
              Visibility="{Binding ShowWelcomeState,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560">

                <TextBlock Text="Open a Wartales File to Begin"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Style="{StaticResource UtilityMajorHeadingTextStyle}"/>

                <TextBlock Margin="0,10,0,0"
                           Text="Open an extracted Wartales data file to use Gameplay Tools and the Detailed Editor. Your changes are tracked automatically."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource SupportingTextStyle}"/>

                <StackPanel Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Content="Import From Wartales"
                            Style="{StaticResource UtilityActionButtonStyle}"
                            Command="{Binding ImportFromWartalesCommand}"/>
                    <Button Content="Open Extracted File"
                            Width="150"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding OpenCommand}"/>
                    <Button Content="Profiles"
                            Width="130"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding ShowProfileManagerCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Gameplay Tools workspace -->
        <ScrollViewer Grid.Row="3"
                      Grid.RowSpan="3"
                      Margin="{StaticResource MainWorkspaceMargin}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsGameplayToolsAvailable,
                                           Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="{StaticResource DashboardColumnSpacing}">
                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Starting Game"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Starting Resources"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding StartingResourcesCommand}"
                                    ToolTip="Add extra supplies to every standard new campaign start."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Progression"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="XP Progression"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayProgressionCommand}"
                                    ToolTip="Configure character and profession XP requirements."/>
                            <Button Content="Lectern Knowledge Gain"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.LecternKnowledgeGain}"
                                    ToolTip="Adjust Knowledge earned from using the Lectern during rest."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Professions"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Delicious Meals"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.DeliciousMealChance}"
                                    ToolTip="Choose Delicious Meal chances for Tier 2 and Tier 3 Cooking Pots."/>
                            <Button Content="Forging Assistance"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.ForgingAssistance}"
                                    ToolTip="Choose a more forgiving perfect-heat reaction window."/>
                            <Button Content="Mining &amp; Woodcutting"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.MiningWoodcuttingTiming}"
                                    ToolTip="Choose how quickly the shared timing indicator moves."/>
                            <Button Content="Fishing"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.FishingSpeed}"
                                    ToolTip="Shorten the fishing control phase while preserving the minigame."/>
                            <Button Content="Lockpicking"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.LockpickingTolerance}"
                                    ToolTip="Make difficult lockpicking zones more forgiving."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Camp &amp; Equipment"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Add Camp Facilities"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding ContentCreationCommand}"
                                    CommandParameter="{x:Static services:ContentCreationOperation.AddCampFacilities}"
                                    ToolTip="Enable the Anvil and Apothecary Table and add their Workshop recipes."/>
                            <Button Content="Upgrade All Equipment"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding ContentCreationCommand}"
                                    CommandParameter="{x:Static services:ContentCreationOperation.UpgradeAllEquipment}"
                                    ToolTip="Allow obtainable equipment to be upgraded at the Brotherhood Training Grounds."/>
                            <Button Content="Campfire Expansion"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.CampfireExpansion}"
                                    ToolTip="Increase campfire dimensions and higher-tier assignment capacity."/>
                            <Button Content="Cooking Pot Food Reduction"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.CookingPotFoodReduction}"
                                    ToolTip="Choose food saved per rest by an assigned cook at each tier."/>
                            <Button Content="Workshop Materials"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.WorkshopMaterials}"
                                    ToolTip="Choose Raw Materials produced per rest by an assigned Tinkerer."/>
                            <Button Content="Ruby &amp; Sapphire Value"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.RubySapphireValue}"
                                    ToolTip="Choose the base economy value of Ruby and Sapphire."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Party"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Volunteer Trait"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.VolunteerWages}"
                                    ToolTip="Configure the wage reduction granted by the Volunteer trait."/>
                            <Button Content="Valour Points"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.ValourPoints}"
                                    ToolTip="Configure global Valour, rest recovery, and Tent bonuses by tier."/>
                            <Button Content="Carrying Capacity"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding PartyEconomyCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.CarryingCapacity}"
                                    ToolTip="Configure saddlebags, pony starting capacity, and Hitching Post bonuses."/>
                            <Button Content="Run Stamina Recovery"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.RunStaminaRecovery}"
                                    ToolTip="Choose how quickly overworld running stamina recovers."/>
                            <Button Content="Positive Random Traits"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.PositiveRandomTraits}"
                                    ToolTip="Give future eligible procedural recruits two positive random traits. Existing units are unchanged."/>
                            <Button Content="Random Trait Exclusions"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding RandomTraitExclusionsCommand}"
                                    ToolTip="Choose which traits may appear for future recruits and other eligible procedural units. Existing units are unchanged."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameplayCategoryPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="World"
                                       Style="{StaticResource GameplayCategoryHeadingTextStyle}"/>
                            <Button Content="Movement Speed"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding OverworldMovementSpeedCommand}"
                                    ToolTip="Choose how quickly your party travels across the world map."/>
                            <Button Content="Rain Frequency"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding RainFrequencyCommand}"
                                    ToolTip="Choose how often ordinary rain occurs across supported regions."/>
                            <Button Content="Vendor Refresh"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.VendorRefresh}"
                                    ToolTip="Choose how quickly merchant inventories replenish."/>
                            <Button Content="Request Board Rewards"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding RequestBoardRewardsCommand}"
                                    ToolTip="Increase the base Krown rewards offered by Tavern Request Board missions."/>
                            <Button Content="Resource Replenishment"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.ResourceReplenishment}"
                                    ToolTip="Choose how quickly renewable world resources replenish."/>
                            <Button Content="Battle Camera Zoom"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.BattleCameraZoom}"
                                    ToolTip="Choose maximum camera zoom distance during battles only."/>
                            <Button Content="Nine Puzzle Assistance"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.NinePuzzleAssistance}"
                                    ToolTip="Start the Nine Puzzle with fewer shuffles and more placed tiles."/>
                            <Button Content="Time Between Rests"
                                    Style="{StaticResource GameplayToolButtonStyle}"
                                    Command="{Binding GameplayPresetCommand}"
                                    CommandParameter="{x:Static models:ProgressionType.TimeBetweenRests}"
                                    ToolTip="Choose approximate travel hours before fatigue requires another rest."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Detailed Editor workspace -->
        <Grid Grid.Row="3"
              Grid.RowSpan="3"
              Visibility="{Binding IsDetailedEditorAvailable,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Language-data setup -->
        <Border Grid.Row="0"
                Margin="5"
                Style="{StaticResource InformationalPanelStyle}"
                Visibility="{Binding ShouldShowLanguageDataSetup,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding LanguageDataSetupMessage}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Content="Set Up Language Data"
                        Margin="12,0,0,0"
                        MinWidth="155"
                        Padding="10,5"
                        Command="{Binding ShowLanguageDataCommand}"/>
            </Grid>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="1"
              Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Search:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox Grid.Column="1"
                     Name="SearchBox"
                     MinWidth="180"
                     Margin="0,0,6,0"
                     Text="{Binding SearchText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="2"
                    Content="Clear"
                    Margin="0,0,12,0"
                    Style="{StaticResource SearchClearButtonStyle}"
                    Command="{Binding ClearSearchCommand}"/>

            <TextBlock Grid.Column="3"
                       Text="In:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox Grid.Column="4"
                      Width="110"
                      Margin="0,0,15,0"
                      SelectedValuePath="Content"
                      SelectedValue="{Binding SearchScope,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}">

                <ComboBoxItem>Settings</ComboBoxItem>
                <ComboBoxItem>Categories</ComboBoxItem>
                <ComboBoxItem>Properties</ComboBoxItem>
                <ComboBoxItem>Item Names</ComboBoxItem>

            </ComboBox>

            <TextBlock Grid.Column="5"
                       Text="{Binding LocalizationStatus}"
                       Style="{StaticResource SupportingTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding LocalizationStatus}"/>

        </Grid>

        <!-- Find Anything -->
        <Grid Grid.Row="2"
              Margin="5,0,5,5"
              MaxHeight="160"
              Visibility="{Binding HasSearchText,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding FindAnythingHeader}"
                       FontWeight="Bold"
                       Margin="5,3,5,5"/>

            <Grid Grid.Row="1">

                <ListView x:Name="SearchResultsList"
                          ItemsSource="{Binding SearchResults}"
                          SelectedItem="{Binding SelectedSearchResult,
                                                 Mode=TwoWay}">

                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="HasItems"
                                         Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header="Category"
                                            Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CategoryName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Setting"
                                            Width="470">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Matched Property"
                                            Width="255">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MatchedProperty}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding MatchedProperty}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                </ListView>

                <TextBlock Text="No matching settings or values found."
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchResultsList,
                                                               Path=HasItems}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>

        </Grid>

        <!-- Main Area -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="370"
                                  MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Categories and Settings -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Categories"
                                   Style="{StaticResource DetailedEditorSectionHeadingTextStyle}"/>

                        <CheckBox Grid.Column="1"
                                  Content="Show Empty"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  ToolTip="Show Empty Categories"
                                  IsChecked="{Binding ShowEmptyCategories,
                                                      Mode=TwoWay}"/>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="Settings"
                               Style="{StaticResource DetailedEditorSectionHeadingTextStyle}"
                               Margin="5"/>

                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="CategoriesList"
                                 Grid.Row="0"
                                 ItemsSource="{Binding Sheets}"
                                 SelectedItem="{Binding SelectedSheet}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No categories match the current search."
                                   Grid.Row="0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVisibleCategories}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="1"
                                   Text="Select a category to view its settings."
                                   Margin="5,6,5,2"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SupportingTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasVisibleCategories}" Value="True"/>
                                                <Condition Binding="{Binding HasSelectedCategory}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="1"
                          Margin="5">
                        <ListBox x:Name="SettingsList"
                                 ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Select a category to view its settings."
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedCategory}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No settings are available in this category."
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSelectedCategory}" Value="True"/>
                                                <Condition Binding="{Binding SelectedCategoryHasSettings}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No settings match the current search."
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCategoryHasSettings}" Value="True"/>
                                                <Condition Binding="{Binding HasVisibleSettings}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Select a setting to view its values."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasVisibleSettings}" Value="True"/>
                                                <Condition Binding="{Binding HasSelectedSetting}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </Grid>

            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="5,5,5,0"
                        Style="{StaticResource DetailedEditorContextPanelStyle}"
                        Visibility="{Binding HasSelectedSetting,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedSettingTitle}"
                                       ToolTip="{Binding SelectedSettingTitle}"
                                       Style="{StaticResource DetailedEditorContextHeadingTextStyle}"/>
                            <TextBlock Text="{Binding SelectedSettingContext}"
                                       ToolTip="{Binding SelectedSettingContext}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource SupportingTextStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedSettingModificationStatus}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModifiedAccentBrush}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="10,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Properties"
                               Style="{StaticResource DetailedEditorSectionHeadingTextStyle}"/>

                    <Button Grid.Column="1"
                            Content="Restore Original Value"
                            Margin="10,0,5,0"
                            Style="{StaticResource DetailedEditorLocalActionButtonStyle}"
                            Command="{Binding ResetSelectedPropertyCommand}"
                            IsEnabled="{Binding CanResetSelectedProperty}"
                            ToolTip="Restore the selected property to its original value."/>

                </Grid>

                <Grid Grid.Row="2"
                      Margin="5">
                    <ListView x:Name="PropertiesListView"
                              ItemsSource="{Binding Properties}"
                              SelectedItem="{Binding SelectedProperty,
                                                     Mode=TwoWay}"
                              PreviewGotKeyboardFocus="PropertiesListView_PreviewGotKeyboardFocus"
                              PreviewMouseLeftButtonDown="PropertiesListView_PreviewMouseLeftButtonDown"
                              SelectionChanged="PropertiesListView_SelectionChanged">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsModified}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="{StaticResource ModifiedRowBackgroundBrush}"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header=""
                                            Width="28">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="●"
                                                   Foreground="{StaticResource ModifiedAccentBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="This value has unsaved changes."
                                                   Visibility="{Binding IsModified,
                                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Property"
                                            Width="200">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <TextBlock Text="{Binding EffectivePropertyPath,
                                                                          StringFormat='Internal path: {0}'}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Value"
                                            Width="350">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource PropertyEditorSelector}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                    </ListView>

                    <TextBlock Text="No editable values are available for this setting."
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource DetailedEditorEmptyStateTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelectedSetting}" Value="True"/>
                                            <Condition Binding="{Binding HasVisibleProperties}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </Grid>

        </Grid>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="6">

            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=StatusBar},
                                  Path=ActualWidth}">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Name="StatusText"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="●"
                               Foreground="{StaticResource ModifiedAccentBrush}"
                               Margin="0,0,5,0"
                               Visibility="{Binding HasModifications,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding ModificationStatus}">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Foreground"
                                        Value="Gray"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasModifications}"
                                                 Value="True">

                                        <Setter Property="Foreground"
                                                Value="{StaticResource ModifiedAccentBrush}"/>

                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Grid>

        </StatusBar>

    </Grid>

</Window>
