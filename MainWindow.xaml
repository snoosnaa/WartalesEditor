<Window x:Class="WartalesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Wartales Editor"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Name="OpenButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding OpenCommand}">
                Open
            </Button>

            <Button Name="SaveButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding SaveCommand}">
                Save
            </Button>
        </ToolBar>

        <!-- Search -->
        <DockPanel Grid.Row="1"
                   Margin="5">

            <TextBlock Text="Search:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox Name="SearchBox"
                     Width="250"
                     Margin="0,0,10,0"
                     Text="{Binding SearchText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="In:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox Width="110"
                      Margin="0,0,15,0"
                      SelectedValuePath="Content"
                      SelectedValue="{Binding SearchScope,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}">

                <ComboBoxItem>Settings</ComboBoxItem>
                <ComboBoxItem>Categories</ComboBoxItem>
                <ComboBoxItem>Properties</ComboBoxItem>

            </ComboBox>

            <CheckBox Content="Show Empty Categories"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowEmptyCategories,
                                          Mode=TwoWay}"/>
            <TextBlock Text="{Binding LocalizationStatus}"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

        </DockPanel>

        <!-- Global Search Results -->
        <Grid Grid.Row="2"
              Margin="5,0,5,5"
              MaxHeight="160"
              Visibility="{Binding HasSearchText,
                           Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding FindAnythingHeader}"
                       FontWeight="Bold"
                       Margin="5,3,5,5"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedSearchResult,
                                             Mode=TwoWay}">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="Category"
                    Width="180"
                    DisplayMemberBinding="{Binding CategoryName}"/>

                        <GridViewColumn Header="Name"
                    Width="600"
                    DisplayMemberBinding="{Binding DisplayName}"/>

                    </GridView>
                </ListView.View>

            </ListView>

        </Grid>

        <!-- Main Area -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories and Settings -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5,5,5,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Categories"
                               FontWeight="Bold"
                               Margin="5"/>

                    <TextBlock Grid.Column="1"
                               Text="Settings"
                               FontWeight="Bold"
                               Margin="5"/>

                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="5"
                             ItemsSource="{Binding Sheets}"
                             SelectedItem="{Binding SelectedSheet}"
                             DisplayMemberPath="Name"/>

                    <ListBox Grid.Column="1"
                             Margin="5"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             DisplayMemberPath="DisplayName"/>

                </Grid>

            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Properties"
                           FontWeight="Bold"
                           Margin="10,5,5,0"/>

                <ListView Grid.Row="1"
                          Margin="5"
                          ItemsSource="{Binding Properties}"
                          SelectedItem="{Binding SelectedProperty,
                                 Mode=TwoWay}">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="Property"
                                            Width="200"
                                            DisplayMemberBinding="{Binding Name}"/>

                            <GridViewColumn Header="Value"
                                            Width="350">

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="330"
                                                 Text="{Binding Value,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                        </GridView>
                    </ListView.View>

                </ListView>

            </Grid>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4">
            <TextBlock Name="StatusText"
                       Text="{Binding Status}"/>
        </StatusBar>

    </Grid>

</Window>