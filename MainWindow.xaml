<Window x:Class="WartalesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:WartalesEditor.Selectors"
        xmlns:converters="clr-namespace:WartalesEditor.Converters"
        xmlns:validation="clr-namespace:WartalesEditor.Validation"
        xmlns:services="clr-namespace:WartalesEditor.Services"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="550"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <converters:BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <converters:FirstValidationErrorConverter
            x:Key="FirstValidationErrorConverter"/>

        <!-- Standard text property -->
        <DataTemplate x:Key="TextEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}"
                     Text="{Binding Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

        </DataTemplate>

        <!-- Integer or decimal property -->
        <DataTemplate x:Key="NumberEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="{Binding IsReadOnly}"
                     Background="{x:Null}">

                <TextBox.Style>

                    <Style TargetType="TextBox">

                        <Setter Property="ToolTip"
                                Value="{x:Null}"/>

                        <Style.Triggers>

                            <Trigger Property="Validation.HasError"
                                     Value="True">

                                <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                        Path=(Validation.Errors),
                                                        Converter={StaticResource FirstValidationErrorConverter}}"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </TextBox.Style>

                <TextBox.Text>

                    <Binding Path="Value"
                             Mode="TwoWay"
                             UpdateSourceTrigger="PropertyChanged"
                             ValidatesOnExceptions="True"
                             NotifyOnValidationError="True">

                        <Binding.ValidationRules>

                            <validation:PropertyValidationRule
                                ValidationStep="UpdatedValue"/>

                        </Binding.ValidationRules>

                    </Binding>

                </TextBox.Text>

            </TextBox>

        </DataTemplate>

        <!-- Boolean property -->
        <DataTemplate x:Key="BooleanEditorTemplate">

            <CheckBox IsChecked="{Binding Value,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"
                      VerticalAlignment="Center"
                      Margin="5,0"/>

        </DataTemplate>

        <!-- Property with a known list of valid choices -->
        <DataTemplate x:Key="DropdownEditorTemplate">

            <ComboBox Width="330"
                      ItemsSource="{Binding AvailableValues}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Value,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"/>

        </DataTemplate>

        <!-- Array or object awaiting a dedicated editor -->
        <DataTemplate x:Key="ComplexEditorTemplate">

            <TextBox Width="330"
                     MinHeight="55"
                     MaxHeight="180"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Gainsboro"
                     Text="{Binding Value}"/>

        </DataTemplate>

        <!-- Internal or otherwise protected property -->
        <DataTemplate x:Key="ReadOnlyEditorTemplate">

            <TextBox Width="330"
                     IsReadOnly="True"
                     Background="Gainsboro"
                     Text="{Binding Value}"/>

        </DataTemplate>

        <selectors:PropertyEditorTemplateSelector
            x:Key="PropertyEditorSelector"
            TextTemplate="{StaticResource TextEditorTemplate}"
            NumberTemplate="{StaticResource NumberEditorTemplate}"
            BooleanTemplate="{StaticResource BooleanEditorTemplate}"
            DropdownTemplate="{StaticResource DropdownEditorTemplate}"
            ComplexTemplate="{StaticResource ComplexEditorTemplate}"
            ReadOnlyTemplate="{StaticResource ReadOnlyEditorTemplate}"/>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Application Menu -->
        <Menu Grid.Row="0">

            <MenuItem Header="_File">

                <MenuItem Header="_Open..."
                          Command="{Binding OpenCommand}"
                          InputGestureText="Ctrl+O"/>

                <MenuItem Header="_Save As..."
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S"/>

                <Separator/>

                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click"/>

            </MenuItem>

            <MenuItem Header="_Edit">

                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="{Binding UndoDescription}"/>

                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGestureText="Ctrl+Y"
                          ToolTip="{Binding RedoDescription}"/>

                <Separator/>

                <MenuItem Header="_Reset Selected Property"
                          Command="{Binding ResetSelectedPropertyCommand}"/>

            </MenuItem>

            <MenuItem Header="_View">

                <MenuItem Header="_Change Summary"
                          Command="{Binding ShowChangeSummaryCommand}"/>

            </MenuItem>

            <MenuItem Header="_Tools">

                <MenuItem Header="_Profile Manager"
                          Command="{Binding ShowProfileManagerCommand}"
                          ToolTip="Browse mod profiles stored in the Wartales Editor profile library."/>

                <Separator/>

                <MenuItem Header="_Snapshots">

                    <MenuItem Header="_Export Snapshot..."
                              Command="{Binding ExportSnapshotCommand}"
                              ToolTip="Export the current project modifications to a snapshot file."/>

                    <MenuItem Header="_Preview Snapshot..."
                              Command="{Binding PreviewSnapshotCommand}"
                              ToolTip="Preview how a snapshot would apply without modifying the project."/>

                    <MenuItem Header="_Import Snapshot..."
                              Command="{Binding ImportSnapshotCommand}"
                              ToolTip="Safely import and apply compatible changes from a snapshot file."/>

                </MenuItem>

                <Separator/>

                <MenuItem Header="_Validate Project"
                          Command="{Binding ValidateProjectCommand}"
                          ToolTip="Run the validation framework against the current project."/>

                <Separator/>

                <MenuItem Header="_Content Creation">

                    <MenuItem Header="Add Camp Facilities"
                              Command="{Binding ContentCreationCommand}"
                              CommandParameter="{x:Static services:ContentCreationOperation.AddCampFacilities}"
                              ToolTip="Enable the Anvil and Apothecary Table and add their Workshop recipes."/>

                </MenuItem>

                <MenuItem Header="_Developer Tools"
                          IsEnabled="False"
                          ToolTip="Developer diagnostics will be added when needed."/>

            </MenuItem>

            <MenuItem Header="_Help">

                <MenuItem Header="_About Wartales Editor"
                          IsEnabled="False"/>

            </MenuItem>

        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">

            <Button Name="OpenButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding OpenCommand}">
                Open
            </Button>

            <Button Name="SaveButton"
                    Width="80"
                    Margin="5"
                    Command="{Binding SaveCommand}">
                Save
            </Button>

            <Separator/>

            <Button Name="UndoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding UndoCommand}"
                    ToolTip="{Binding UndoDescription}">
                Undo
            </Button>

            <Button Name="RedoButton"
                    Width="80"
                    Margin="5"
                    Focusable="False"
                    Command="{Binding RedoCommand}"
                    ToolTip="{Binding RedoDescription}">
                Redo
            </Button>

            <Separator/>

            <Button Name="ResetPropertyButton"
                    Width="120"
                    Margin="5"
                    Command="{Binding ResetSelectedPropertyCommand}">
                Reset Property
            </Button>

            <Separator/>

            <Button Name="ChangeSummaryButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowChangeSummaryCommand}">
                Change Summary
            </Button>

            <Button Name="ProfileManagerButton"
                    Width="130"
                    Margin="5"
                    Command="{Binding ShowProfileManagerCommand}">
                Profile Manager
            </Button>

        </ToolBar>

        <!-- Search -->
        <DockPanel Grid.Row="2"
                   Margin="5">

            <TextBlock Text="Search:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox Name="SearchBox"
                     Width="250"
                     Margin="0,0,10,0"
                     Text="{Binding SearchText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="In:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox Width="110"
                      Margin="0,0,15,0"
                      SelectedValuePath="Content"
                      SelectedValue="{Binding SearchScope,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}">

                <ComboBoxItem>Settings</ComboBoxItem>
                <ComboBoxItem>Categories</ComboBoxItem>
                <ComboBoxItem>Properties</ComboBoxItem>

            </ComboBox>

            <CheckBox Content="Show Empty Categories"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowEmptyCategories,
                                          Mode=TwoWay}"/>

            <TextBlock Text="{Binding LocalizationStatus}"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

        </DockPanel>

        <!-- Find Anything -->
        <Grid Grid.Row="3"
              Margin="5,0,5,5"
              MaxHeight="160"
              Visibility="{Binding HasSearchText,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding FindAnythingHeader}"
                       FontWeight="Bold"
                       Margin="5,3,5,5"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedSearchResult,
                                             Mode=TwoWay}">

                <ListView.View>

                    <GridView>

                        <GridViewColumn Header="Category"
                                        Width="180"
                                        DisplayMemberBinding="{Binding CategoryName}"/>

                        <GridViewColumn Header="Name"
                                        Width="600"
                                        DisplayMemberBinding="{Binding DisplayName}"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Grid>

        <!-- Main Area -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Categories and Settings -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Categories"
                               FontWeight="Bold"
                               Margin="5"/>

                    <TextBlock Grid.Column="1"
                               Text="Settings"
                               FontWeight="Bold"
                               Margin="5"/>

                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>

                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="5"
                             ItemsSource="{Binding Sheets}"
                             SelectedItem="{Binding SelectedSheet}"
                             DisplayMemberPath="Name"/>

                    <ListBox Grid.Column="1"
                             Margin="5"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             DisplayMemberPath="DisplayName"/>

                </Grid>

            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="10,5,5,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Properties"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ModificationStatus}"
                               Margin="10,0,5,0"
                               VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="FontWeight"
                                        Value="Normal"/>

                                <Setter Property="Foreground"
                                        Value="Gray"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasModifications}"
                                                 Value="True">

                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>

                                        <Setter Property="Foreground"
                                                Value="DarkOrange"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <ListView Grid.Row="1"
                          Margin="5"
                          ItemsSource="{Binding Properties}"
                          SelectedItem="{Binding SelectedProperty,
                                                 Mode=TwoWay}">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsModified}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="LightGoldenrodYellow"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header=""
                                            Width="28">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="●"
                                                   Foreground="DarkOrange"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="This property has unsaved changes"
                                                   Visibility="{Binding IsModified,
                                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Property"
                                            Width="200">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <GridViewColumn Header="Value"
                                            Width="350">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource PropertyEditorSelector}"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Grid>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5">

            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=StatusBar},
                                  Path=ActualWidth}">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Name="StatusText"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="●"
                               Foreground="DarkOrange"
                               Margin="0,0,5,0"
                               Visibility="{Binding HasModifications,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding ModificationStatus}">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Foreground"
                                        Value="Gray"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasModifications}"
                                                 Value="True">

                                        <Setter Property="Foreground"
                                                Value="DarkOrange"/>

                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Grid>

        </StatusBar>

    </Grid>

</Window>